rules_version = '2';

// =============================================================================
// Novudent — Firestore Security Rules (aislamiento multi-clínica)
//
// Modelo: el navegador del personal de la clínica lee/escribe Firestore
// DIRECTAMENTE. Estas reglas son la ÚNICA frontera entre clínicas — no hay
// proxy de servidor para las operaciones del dashboard. Sin ellas, cualquier
// usuario autenticado (incluso un anónimo de la demo) podría leer pacientes,
// facturación e historiales de OTRA clínica.
//
// Reglas clave:
//   • Un usuario pertenece a la clínica {cid} sii existe el doc
//     clinics/{cid}/users/{suUid}. Esa es la fuente de verdad de membresía.
//   • Solo los admin escriben la config de la clínica y la lista de usuarios
//     (cierra la escalada de privilegios: un asistente no puede auto-ascenderse).
//   • La demo (cl_demo) es un sandbox público: cualquier sesión (anónima
//     incluida) puede leer/escribir — son datos de ejemplo descartables.
//   • Los "service users" del servidor (Botika worker, rutas /api/*) no son
//     miembros de ninguna clínica; se habilitan con un doc allowlist en
//     serviceAccounts/{suUid}. Como no se pueden crear service-account keys en
//     este proyecto (org policy), este es el mecanismo de elevación.
//
// ⚠ ANTES DE DESPLEGAR: crear serviceAccounts/{uid} para el/los usuario(s) de
//   servicio, o se rompen Botika y las reservas online. Ver SECURITY.md.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Usuario de servidor habilitado (allowlist). get()/exists() dentro de las
    // reglas son privilegiados: no quedan sujetos a las reglas de serviceAccounts.
    function isService() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/serviceAccounts/$(request.auth.uid));
    }

    // La demo es un sandbox abierto (datos de ejemplo).
    function isDemo(cid) {
      return cid == 'cl_demo';
    }

    // Miembro de la clínica: tiene doc en clinics/{cid}/users/{uid}.
    function isMember(cid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid));
    }

    // Admin de la clínica: miembro con role == 'admin'.
    function isAdmin(cid) {
      return isMember(cid)
        && get(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid)).data.role == 'admin';
    }

    // "Staff" administrativo (admin o asistente). El dentista NO maneja dinero
    // (matriz RBAC: payments.manage / expenses.manage = [admin, asistente]).
    function isStaff(cid) {
      return isMember(cid)
        && get(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid)).data.role in ['admin', 'assistant'];
    }

    // Rol clínico (admin o dentista). El ASISTENTE no escribe el EMR
    // (matriz RBAC: emr.write = [admin, dentist]). Se usa para blindar los campos
    // clínicos del doc de paciente a nivel de reglas, no solo en la UI.
    function isClinical(cid) {
      return isMember(cid)
        && get(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid)).data.role in ['admin', 'dentist'];
    }

    // ---- Monetización: suscripción vigente y plan contratado ----
    // Los get() al mismo path se cachean dentro de una misma evaluación, así que
    // usar estos helpers en varias condiciones cuesta UNA sola lectura.

    function subPath(cid) {
      return /databases/$(database)/documents/subscriptions/$(cid);
    }

    // ¿La clínica puede ESCRIBIR? Sin doc de suscripción → sí (grandfathering:
    // las clínicas anteriores al cobro no pueden quedar en solo-lectura de un día
    // para el otro). Con doc: solo si está al día Y el período no venció — la
    // fecha se chequea aparte del status por si se perdió un webhook de impago.
    function subActive(cid) {
      return !exists(subPath(cid))
        || (get(subPath(cid)).data.status in ['active', 'trialing']
            && (!('currentPeriodEndMs' in get(subPath(cid)).data)
                || request.time.toMillis() < get(subPath(cid)).data.currentPeriodEndMs));
    }

    // Plan efectivo: el de la suscripción; si no hay doc, el legacy de
    // clinics/{cid}.plan (seguro de leer: el admin ya no puede modificarlo).
    // Sin ninguno de los dos → 'clinica', el default histórico.
    function effectivePlan(cid) {
      return exists(subPath(cid))
        ? get(subPath(cid)).data.plan
        : (exists(/databases/$(database)/documents/clinics/$(cid))
            && 'plan' in get(/databases/$(database)/documents/clinics/$(cid)).data
              ? get(/databases/$(database)/documents/clinics/$(cid)).data.plan
              : 'clinica');
    }

    // Escritura de datos operativos: miembro + suscripción vigente.
    // El servicio y la demo nunca se bloquean por cobro.
    function canWrite(cid) {
      return (isMember(cid) && subActive(cid)) || isService() || isDemo(cid);
    }

    // Igual que canWrite pero además exige que el plan incluya el módulo premium.
    // El gating de plan vivía SOLO en la UI (useClinicPlan/<PlanLocked>): sin
    // esto, un cliente del plan Solo escribe estas colecciones por SDK directo.
    function canWritePremium(cid, planes) {
      return (isMember(cid) && subActive(cid) && effectivePlan(cid) in planes)
        || isService() || isDemo(cid);
    }

    // Campos del doc de paciente que son EMR clínico (odontograma, evoluciones,
    // recetas, ortodoncia, periodontograma). Solo rol clínico puede cambiarlos.
    // La demografía y el engagement (nombre, teléfono, forms, nps…) NO están acá:
    // los edita cualquier miembro (recepción/asistente).
    function patientClinicalFields() {
      return ['emr', 'odontogram', 'prescriptions', 'ortho', 'perio'];
    }

    // ---- Allowlist de servicio: nunca accesible por el cliente. ----
    // isService() la consulta con exists() (privilegiado), así que puede quedar
    // totalmente cerrada. Solo el dueño la edita desde la consola de Firebase.
    match /serviceAccounts/{uid} {
      allow read, write: if false;
    }

    // ---- Directorio global uid → clínica (login multi-clínica). ----
    // Lectura: solo tu propia entrada (o el servidor). Creación: un admin solo
    // puede crear una entrada que apunte a SU clínica, y solo si no existe
    // (no puede secuestrar el routing de otro usuario). Cambios/borrados: server.
    match /directory/{uid} {
      allow read: if isService() || (isSignedIn() && request.auth.uid == uid);
      // Un admin solo puede crear la entrada de un uid que YA es usuario de su
      // clínica (el users/{uid} se escribe antes), y solo si no existe — no
      // puede sembrar/envenenar el routing de un uid ajeno o aún no provisto.
      allow create: if isService()
        || (isAdmin(request.resource.data.clinicId)
            && !exists(/databases/$(database)/documents/directory/$(uid))
            && exists(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)/users/$(uid)));
      allow update, delete: if isService();
    }

    // ---- Suscripción SaaS (monetización) ----
    // Fuente de verdad del plan contratado. Vive ACÁ, fuera de clinics/{cid},
    // porque ese doc lo escribe el admin de la propia clínica: si el plan
    // viviera ahí, cualquier cliente se auto-ascendería a Cadena gratis desde
    // la consola del navegador. La escribe SOLO el usuario de servicio (el
    // webhook de la pasarela); el cliente apenas la lee para el gating/banner.
    match /subscriptions/{cid} {
      allow read:  if isMember(cid) || isService() || isDemo(cid);
      allow write: if isService();
    }

    // Idempotencia de los webhooks de cobro: un doc por transición ya aplicada,
    // para que los reintentos de la pasarela no la re-apliquen. Nunca la ve el
    // cliente (sin esta regla el default-deny haría fallar el webhook en silencio).
    match /webhookEvents/{eventId} {
      allow read, write: if isService();
    }

    // ---- Clínica + subcolecciones ----
    match /clinics/{cid} {
      // Doc raíz: config de la clínica. Lectura: miembros/servidor/demo.
      allow read: if isMember(cid) || isService() || isDemo(cid);
      // Alta/baja de clínicas: solo el servidor (/api/clinicas del panel del
      // dueño). Un admin de clínica no crea ni borra clínicas.
      allow create, delete: if isService() || isDemo(cid);
      // Update: el admin edita la config, PERO NO el campo `plan` — ese lo fija
      // la suscripción de arriba. Sin esta lista negra, cambiar `plan` a
      // "cadena" desbloquea todos los módulos premium sin pagar.
      allow update: if isService() || isDemo(cid)
        || (isAdmin(cid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']));

      // Equipo: solo admin gestiona usuarios (anti-escalada de privilegios).
      // NOTA: este bloque NO comparte wildcard con los de datos de abajo, así
      // que un miembro común no puede escribir usuarios por el "OR" de reglas.
      match /users/{uid} {
        allow read:   if isMember(cid) || isService() || isDemo(cid);
        allow create: if isAdmin(cid)  || isService() || isDemo(cid);
        allow delete: if isAdmin(cid)  || isService() || isDemo(cid);
        // Update: admin/servicio/demo libres. Un usuario puede editar SU PROPIO
        // doc pero SOLO nombre y color (lista BLANCA). NO puede tocar
        // role/active/clinicId/email (escalada) NI commissionPct (fraude de
        // comisiones) NI mustChangePassword (saltarse el cambio forzado: ese
        // flag solo lo limpia el servidor tras rotar la contraseña real).
        allow update: if isService() || isDemo(cid) || isAdmin(cid)
          || (request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color']));
      }

      // Datos operativos: cualquier miembro de la clínica (RBAC fino se aplica
      // en la UI; acá garantizamos el aislamiento entre clínicas). Enumeradas
      // explícitamente: una subcolección nueva no listada queda DENEGADA por
      // defecto (preferimos negar a filtrar).
      // Paciente: lectura/alta/borrado = cualquier miembro (recepción da de alta).
      // Actualización: rol clínico/servicio/demo sin tope; otros miembros
      // (asistente) pueden editar demografía pero NO los campos clínicos del EMR
      // (odontograma/evoluciones/recetas/orto/perio) — blindaje a nivel de reglas
      // del RBAC emr.write, no solo de la UI. diff().affectedKeys() solo marca los
      // campos cuyo VALOR cambió, así que un guardado que deja el EMR intacto pasa.
      match /patients/{docId} {
        // Lectura SIEMPRE, aunque la suscripción esté vencida: son historias
        // clínicas y la clínica tiene que poder consultarlas y exportarlas.
        allow read: if isMember(cid) || isService() || isDemo(cid);
        allow create, delete: if canWrite(cid);
        // Escritura: suscripción vigente + el RBAC de EMR (el asistente no toca
        // los campos clínicos; ver patientClinicalFields()).
        allow update: if isService() || isDemo(cid)
          || (isMember(cid) && subActive(cid)
              && (isClinical(cid)
                  || !request.resource.data.diff(resource.data).affectedKeys().hasAny(patientClinicalFields())));
      }
      match /appointments/{docId}{
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // billing: lo escriben admin (finaliza), asistente (envía a cobro) y
      // dentista (finaliza) — todos los roles según la matriz, así que isMember.
      match /billing/{docId}     {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      match /procedures/{docId}  {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      match /budgets/{docId}     {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Dinero (caja/gastos): el dentista NO maneja dinero. Lectura: cualquier
      // miembro; escritura: solo staff (admin/asistente). Cierra el fraude
      // financiero vía SDK directo saltándose el RBAC de la UI.
      match /payments/{docId}    { allow read: if isMember(cid) || isService() || isDemo(cid);
                                   allow write: if (isStaff(cid) && subActive(cid)) || isService() || isDemo(cid); }
      // Gastos = costos del negocio (alquiler, proveedores, sueldos). Solo el
      // dueño, y también en LECTURA: el gating de la UI no alcanza porque el
      // cliente lee Firestore directo y podría sacarlos por SDK.
      match /expenses/{docId}    { allow read: if isAdmin(cid) || isService() || isDemo(cid);
                                   allow write: if (isAdmin(cid) && subActive(cid)) || isService() || isDemo(cid); }
      match /stock/{docId}       {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      match /stockMoves/{docId}  {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      match /waitlist/{docId}    {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      match /outbox/{docId}      {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Lock atómico de slots de reserva online (lo crea el service user).
      match /slotLocks/{docId}   {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Monitor de recuperación post-op (lo escriben miembros y el service user)
      match /recoveryMonitors/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Análisis IA de radiografías (lo escriben miembros y el service user)
      match /radiographs/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      // Firma electrónica de consentimientos. La firma remota (página pública
      // /firmar) la escribe el service user vía /api/firmar → cubierta por isService().
      match /signatures/{sid} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      // Módulos de paridad Dentalink (CRM, Laboratorios, Liquidaciones, Box/Sillones)
      match /crmCards/{docId}    {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['cadena']);
      }
      match /campaigns/{docId}   {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['cadena']);
      }
      match /labOrders/{docId}   {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      // Liquidaciones = cuánto gana cada profesional. Es dato salarial: no lo ve
      // el resto del equipo (ni siquiera el dentista sus propias comisiones por
      // esta vía) ni la recepción. Solo el dueño.
      match /settlements/{docId} {
        allow read:  if isAdmin(cid) || isService() || isDemo(cid);
        allow write: if (isAdmin(cid) && canWritePremium(cid, ['clinica','cadena'])) || isService() || isDemo(cid);
      }
      match /boxes/{docId}       {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      // Notas del paciente: comentarios administrativos / tareas de gestión / emails
      match /patientNotes/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Documentos fiscales: boletas emitidas / devoluciones
      match /fiscalDocs/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Sesiones de caja: apertura/cierre con arqueo
      match /cashSessions/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Ciclos de esterilización de instrumental (cumplimiento)
      match /sterilizationCycles/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Chat interno del equipo
      match /teamMessages/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Encuestas (definición): admin escribe; la respuesta pública entra por route de servicio
      match /surveys/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Respuestas de encuestas: alta pública (sin sesión) vía route de servicio
      match /surveyResponses/{docId} {
        allow read: if isMember(cid) || isService() || isDemo(cid);
        allow write: if isService() || isDemo(cid);
      }
      // Tareas de gestión (bandeja captura/control/cobranza/cita)
      match /mgmtTasks/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Registro ambiental de residuos (cumplimiento)
      match /environmentalLogs/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Biblioteca de videos educativos / 3D
      match /eduVideos/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Sucursales / sedes (multi-sede)
      match /branches/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
    }

    // Todo lo demás: denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
