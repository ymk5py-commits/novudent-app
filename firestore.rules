rules_version = '2';

// =============================================================================
// Novudent — Firestore Security Rules (aislamiento multi-clínica)
//
// Modelo: el navegador del personal de la clínica lee/escribe Firestore
// DIRECTAMENTE. Estas reglas son la ÚNICA frontera entre clínicas — no hay
// proxy de servidor para las operaciones del dashboard. Sin ellas, cualquier
// usuario autenticado (incluso un anónimo de la demo) podría leer pacientes,
// facturación e historiales de OTRA clínica.
//
// Reglas clave:
//   • Un usuario pertenece a la clínica {cid} sii existe el doc
//     clinics/{cid}/users/{suUid}. Esa es la fuente de verdad de membresía.
//   • Solo los admin escriben la config de la clínica y la lista de usuarios
//     (cierra la escalada de privilegios: un asistente no puede auto-ascenderse).
//   • La demo (cl_demo) es un sandbox público: cualquier sesión (anónima
//     incluida) puede leer/escribir — son datos de ejemplo descartables.
//   • Los "service users" del servidor (Botika worker, rutas /api/*) no son
//     miembros de ninguna clínica; se habilitan con un doc allowlist en
//     serviceAccounts/{suUid}. Como no se pueden crear service-account keys en
//     este proyecto (org policy), este es el mecanismo de elevación.
//
// ⚠ ANTES DE DESPLEGAR: crear serviceAccounts/{uid} para el/los usuario(s) de
//   servicio, o se rompen Botika y las reservas online. Ver SECURITY.md.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Usuario de servidor habilitado (allowlist). get()/exists() dentro de las
    // reglas son privilegiados: no quedan sujetos a las reglas de serviceAccounts.
    function isService() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/serviceAccounts/$(request.auth.uid));
    }

    // LA DEMO SE LEE SIN SESION, PERO NO SE ESCRIBE SIN SESION.
    //
    // `cl_demo` es el sandbox de ventas: datos de ejemplo publicados a proposito,
    // para que un prospecto entre sin cuenta. Leerlos sin credenciales es
    // deliberado. ESCRIBIRLOS no: hasta ahora cualquiera desde internet podia
    // cargar, pisar y borrar documentos ahi sin autenticarse. Eso permitia
    // vandalizar lo que le mostras a un cliente, y sobre todo quemar la cuota del
    // MISMO proyecto Firebase que usan las clinicas reales — que factura, porque
    // el proyecto esta en Blaze.
    //
    // Al entrar a la demo el cliente abre una sesion ANONIMA (ver
    // signInAnonymousIfNeeded en lib/firebase.ts). Con eso la demo sigue andando
    // igual y la escritura deja de ser anonima-sin-sesion.
    function isDemo(cid) {              // LECTURA: sin sesion
      return cid == 'cl_demo';
    }
    function isDemoRW(cid) {            // ESCRITURA: exige sesion
      return cid == 'cl_demo' && isSignedIn();
    }

    // Miembro de la clínica: tiene doc en clinics/{cid}/users/{uid} Y no está
    // dado de baja. El chequeo de `active` va ACÁ, en las reglas, no solo en el
    // login del cliente: sin esto, a un empleado despedido se le marcaba
    // `active:false` pero su credencial seguía válida, y desde la consola del
    // navegador leía, editaba y borraba toda la historia clínica. `.get(campo,
    // default)` trata como activo a los docs viejos que no tengan el campo.
    // Pasa de exists() a get() (una lectura), pero isAdmin/isCaja/isRecepcion/isClinical
    // ya hacían ese get al mismo path, y dentro de una evaluación se cachea.
    function isMember(cid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid)).data.get('active', true) != false;
    }

    // Admin de la clínica: miembro con role == 'admin'.
    function isAdmin(cid) {
      return isMember(cid)
        && get(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Permisos del equipo (Administración › Permisos del equipo) ----
    // La clínica guarda en clinics/{cid}.config.permisos[rol] = { dar: [...], quitar: [...] }: la DIFERENCIA contra la matriz de
    // fábrica de lib/rbac.ts. `tienePermiso` hace la misma cuenta que `permisoEfectivo()` del cliente, y las dos tienen que dar
    // siempre lo mismo (lib/rbac.test.ts ata cada lista `rolesDeFabrica` de abajo a la matriz):
    //   • el admin siempre puede: no se le puede sacar nada;
    //   • lo que figura en `dar` lo puede el rol aunque la fábrica no se lo dé;
    //   • lo demás lo puede si el rol está en `rolesDeFabrica` y el permiso no figura en `quitar`.
    // Un permiso en `dar` y en `quitar` a la vez gana `dar`. Lo mal formado (un rol que no es un mapa, una lista que no es una
    // lista) se ignora y rige la fábrica: mejor eso que dejar a un rol sin poder trabajar por un dato roto.
    // Nadie se da permisos a sí mismo: clinics/{cid} solo lo actualiza el admin (ver más abajo). Cuesta una lectura más (el doc
    // de la clínica), que se cachea dentro de la misma solicitud.
    function rolDe(cid) {
      return get(/databases/$(database)/documents/clinics/$(cid)/users/$(request.auth.uid)).data.role;
    }
    function ajustesDeRol(cid) {
      let config = get(/databases/$(database)/documents/clinics/$(cid)).data.get('config', {});
      let permisos = config is map ? config.get('permisos', {}) : {};
      let ajustes = permisos is map ? permisos.get(rolDe(cid), {}) : {};
      return ajustes is map ? ajustes : {};
    }
    function listaDe(ajustes, clave) {
      return ajustes.get(clave, []) is list ? ajustes.get(clave, []) : [];
    }
    function tienePermiso(cid, perm, rolesDeFabrica) {
      return isMember(cid)
        && (rolDe(cid) == 'admin'
            || perm in listaDe(ajustesDeRol(cid), 'dar')
            || (rolDe(cid) in rolesDeFabrica && !(perm in listaDe(ajustesDeRol(cid), 'quitar'))));
    }

    // Caja: cobra, factura y hace el arqueo (payments.manage; de fábrica admin y caja). De fábrica ni la recepcionista, ni el
    // dentista, ni el asistente de doctores manejan dinero.
    function isCaja(cid) {
      return tienePermiso(cid, 'payments.manage', ['admin', 'cashier']);
    }

    // Recepción: consentimientos, firmas y formularios del paciente (engagement.forms; de fábrica admin, caja y recepción).
    function isRecepcion(cid) {
      return tienePermiso(cid, 'engagement.forms', ['admin', 'cashier', 'receptionist']);
    }

    // Rol clínico (emr.write; de fábrica admin y dentista). El ASISTENTE de fábrica no escribe el EMR. Se usa para blindar
    // los campos clínicos del doc de paciente a nivel de reglas, no solo en la UI.
    function isClinical(cid) {
      return tienePermiso(cid, 'emr.write', ['admin', 'dentist']);
    }

    // Gastos del negocio (expenses.manage; de fábrica solo el admin).
    function puedeGastos(cid) {
      return tienePermiso(cid, 'expenses.manage', ['admin']);
    }

    // Liquidaciones = lo que gana cada profesional (billing.reports; de fábrica solo el admin).
    function puedeLiquidaciones(cid) {
      return tienePermiso(cid, 'billing.reports', ['admin']);
    }

    // ---- Monetización: suscripción vigente y plan contratado ----
    // Los get() al mismo path se cachean dentro de una misma evaluación, así que
    // usar estos helpers en varias condiciones cuesta UNA sola lectura.

    function subPath(cid) {
      return /databases/$(database)/documents/subscriptions/$(cid);
    }

    // ¿La clínica puede ESCRIBIR? Sin doc de suscripción → sí (grandfathering:
    // las clínicas anteriores al cobro no pueden quedar en solo-lectura de un día
    // para el otro). Con doc: solo si está al día Y el período no venció — la
    // fecha se chequea aparte del status por si se perdió un webhook de impago.
    function subActive(cid) {
      return !exists(subPath(cid))
        || (get(subPath(cid)).data.status in ['active', 'trialing']
            && (!('currentPeriodEndMs' in get(subPath(cid)).data)
                || request.time.toMillis() < get(subPath(cid)).data.currentPeriodEndMs));
    }

    // Plan efectivo: el de la suscripción; si no hay doc, el legacy de
    // clinics/{cid}.plan (seguro de leer: el admin ya no puede modificarlo).
    // Sin ninguno de los dos → 'clinica', el default histórico.
    function effectivePlan(cid) {
      return exists(subPath(cid))
        ? get(subPath(cid)).data.plan
        : (exists(/databases/$(database)/documents/clinics/$(cid))
            && 'plan' in get(/databases/$(database)/documents/clinics/$(cid)).data
              ? get(/databases/$(database)/documents/clinics/$(cid)).data.plan
              : 'clinica');
    }

    // Escritura de datos operativos: miembro + suscripción vigente.
    // El servicio y la demo nunca se bloquean por cobro.
    function canWrite(cid) {
      return (isMember(cid) && subActive(cid)) || isService() || isDemoRW(cid);
    }

    // Igual que canWrite pero además exige que el plan incluya el módulo premium.
    // El gating de plan vivía SOLO en la UI (useClinicPlan/<PlanLocked>): sin
    // esto, un cliente del plan Solo escribe estas colecciones por SDK directo.
    function canWritePremium(cid, planes) {
      return (isMember(cid) && subActive(cid) && effectivePlan(cid) in planes)
        || isService() || isDemoRW(cid);
    }

    // Campos del doc de paciente que son EMR clínico (odontograma, evoluciones,
    // recetas, ortodoncia, periodontograma). Solo rol clínico puede cambiarlos.
    // La demografía y el engagement (nombre, teléfono, forms, nps…) NO están acá:
    // los edita cualquier miembro (recepción/asistente).
    function patientClinicalFields() {
      return ['emr', 'odontogram', 'prescriptions', 'ortho', 'perio'];
    }

    // Alta de un mensaje directo (chat), SIEMPRE a nombre propio:
    //   • `fromId` es quien escribe: nadie manda un directo a nombre de otro, ni el admin;
    //   • `participants` son exactamente remitente y destinatario, y el destinatario
    //     es OTRA persona activa de la misma clínica;
    //   • texto no vacío y de hasta 2000 caracteres (el mismo tope que la interfaz,
    //     lib/chat.ts MAX_TEXTO);
    //   • `difusionId` (copia de una difusión general) solo lo pone el admin;
    //   • lista blanca de campos: `readAt` no viene en el alta, lo marca después el
    //     destinatario.
    function directoValido(cid, docId) {
      let d = request.resource.data;
      let destinatario = /databases/$(database)/documents/clinics/$(cid)/users/$(d.toId);
      return d.keys().hasAll(['id', 'clinicId', 'fromId', 'fromName', 'toId', 'participants', 'text', 'createdAt'])
        && d.keys().hasOnly(['id', 'clinicId', 'fromId', 'fromName', 'toId', 'participants', 'text', 'createdAt', 'difusionId'])
        && d.id == docId
        && d.clinicId == cid
        && d.fromId == request.auth.uid
        && d.toId is string && d.toId != d.fromId
        && d.participants is list && d.participants.size() == 2
        && d.participants.hasAll([d.fromId, d.toId])
        && d.text is string && d.text.trim().size() > 0 && d.text.size() <= 2000
        && d.fromName is string && d.fromName.size() <= 200
        && d.createdAt is string
        && (!('difusionId' in d) || (d.difusionId is string && isAdmin(cid)))
        && exists(destinatario)
        && get(destinatario).data.get('active', true) != false;
    }

    // ---- Allowlist de servicio: nunca accesible por el cliente. ----
    // isService() la consulta con exists() (privilegiado), así que puede quedar
    // totalmente cerrada. Solo el dueño la edita desde la consola de Firebase.
    match /serviceAccounts/{uid} {
      allow read, write: if false;
    }

    // ---- Directorio global uid → clínica (login multi-clínica). ----
    // Lectura: solo tu propia entrada (o el servidor). Creación: un admin solo
    // puede crear una entrada que apunte a SU clínica, y solo si no existe
    // (no puede secuestrar el routing de otro usuario). Cambios/borrados: server.
    match /directory/{uid} {
      allow read: if isService() || (isSignedIn() && request.auth.uid == uid);
      // Un admin solo puede crear la entrada de un uid que YA es usuario de su
      // clínica (el users/{uid} se escribe antes), y solo si no existe — no
      // puede sembrar/envenenar el routing de un uid ajeno o aún no provisto.
      // La demo queda EXCLUIDA como destino: `cl_demo` se escribe sin sesión, así
      // que ser "admin de la demo" es gratis — cualquiera se planta su propio
      // users/{uid} con rol admin ahí y desde esa silla sembraba el ruteo de un
      // uid ajeno hacia la demo. Ninguna cuenta real se rutea a la demo jamás.
      allow create: if isService()
        || (request.resource.data.clinicId != 'cl_demo'
            && isAdmin(request.resource.data.clinicId)
            && !exists(/databases/$(database)/documents/directory/$(uid))
            && exists(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)/users/$(uid)));
      allow update, delete: if isService();
    }

    // ---- Suscripción SaaS (monetización) ----
    // Fuente de verdad del plan contratado. Vive ACÁ, fuera de clinics/{cid},
    // porque ese doc lo escribe el admin de la propia clínica: si el plan
    // viviera ahí, cualquier cliente se auto-ascendería a Cadena gratis desde
    // la consola del navegador. La escribe SOLO el usuario de servicio (el
    // webhook de la pasarela); el cliente apenas la lee para el gating/banner.
    match /subscriptions/{cid} {
      allow read:  if isMember(cid) || isService() || isDemo(cid);
      allow write: if isService();
    }

    // Idempotencia de los webhooks de cobro: un doc por transición ya aplicada,
    // para que los reintentos de la pasarela no la re-apliquen. Nunca la ve el
    // cliente (sin esta regla el default-deny haría fallar el webhook en silencio).
    match /webhookEvents/{eventId} {
      allow read, write: if isService();
    }

    // Pedidos de acceso desde la landing (/api/contacto). Los escribe SOLO el
    // usuario de servicio, nunca el navegador — el formulario es público y
    // anónimo, así que dejarlo escribir acá sería un buzón abierto a cualquiera.
    // Cerrado también a la LECTURA de clientes: son datos personales de gente
    // que todavía no es cliente (nombre, email, teléfono). El dueño los ve desde
    // la consola de Firebase o desde una ruta de servidor.
    match /leads/{leadId} {
      allow read, write: if isService();
    }

    // Tokens que atan un checkout de Lemon Squeezy a UNA clínica. Cerrados por
    // completo al cliente: si el navegador pudiera leerlos, podría descubrir el
    // token de otra clínica y volver a apuntarle un pago — que es justo el
    // ataque que estos tokens existen para impedir.
    match /checkoutTokens/{token} {
      allow read, write: if isService();
    }

    // ---- Clínica + subcolecciones ----
    match /clinics/{cid} {
      // Doc raíz: config de la clínica. Lectura: miembros/servidor/demo.
      allow read: if isMember(cid) || isService() || isDemo(cid);
      // Alta/baja de clínicas: solo el servidor (/api/clinicas del panel del
      // dueño). Un admin de clínica no crea ni borra clínicas.
      allow create, delete: if isService() || isDemoRW(cid);
      // Update: el admin edita la config, PERO NO el campo `plan` — ese lo fija
      // la suscripción de arriba. Sin esta lista negra, cambiar `plan` a
      // "cadena" desbloquea todos los módulos premium sin pagar.
      allow update: if isService() || isDemoRW(cid)
        || (isAdmin(cid)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']));

      // Equipo: solo admin gestiona usuarios (anti-escalada de privilegios).
      // NOTA: este bloque NO comparte wildcard con los de datos de abajo, así
      // que un miembro común no puede escribir usuarios por el "OR" de reglas.
      match /users/{uid} {
        allow read:   if isMember(cid) || isService() || isDemo(cid);
        allow create: if isAdmin(cid)  || isService() || isDemoRW(cid);
        allow delete: if isAdmin(cid)  || isService() || isDemoRW(cid);
        // Update: admin/servicio/demo libres. Un usuario puede editar SU PROPIO
        // doc pero SOLO nombre y color (lista BLANCA). NO puede tocar
        // role/active/clinicId/email (escalada) NI commissionPct (fraude de
        // comisiones) NI mustChangePassword (saltarse el cambio forzado: ese
        // flag solo lo limpia el servidor tras rotar la contraseña real).
        allow update: if isService() || isDemoRW(cid) || isAdmin(cid)
          || (request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color']));
      }

      // Datos operativos: cualquier miembro de la clínica (RBAC fino se aplica
      // en la UI; acá garantizamos el aislamiento entre clínicas). Enumeradas
      // explícitamente: una subcolección nueva no listada queda DENEGADA por
      // defecto (preferimos negar a filtrar).
      // Paciente: lectura/alta/borrado = cualquier miembro (recepción da de alta).
      // Actualización: rol clínico/servicio/demo sin tope; otros miembros
      // (asistente) pueden editar demografía pero NO los campos clínicos del EMR
      // (odontograma/evoluciones/recetas/orto/perio) — blindaje a nivel de reglas
      // del RBAC emr.write, no solo de la UI. diff().affectedKeys() solo marca los
      // campos cuyo VALOR cambió, así que un guardado que deja el EMR intacto pasa.
      match /patients/{docId} {
        // Lectura SIEMPRE, aunque la suscripción esté vencida: son historias
        // clínicas y la clínica tiene que poder consultarlas y exportarlas.
        allow read: if isMember(cid) || isService() || isDemo(cid);
        /* El blindaje de campos clínicos vive en `update` (más abajo), y por eso
         * `create`/`delete` no podían quedar en "cualquier miembro": el asistente
         * leía la ficha, la BORRABA y la volvía a crear con el `emr` y el
         * odontograma que quisiera. El resultado es indistinguible de un guardado
         * legítimo porque los datos personales se conservan. Además el `delete`
         * suelto es destrucción de historia clínica, que tiene retención legal —
         * y en la interfaz ni siquiera existe salvo en Fusión de fichas, que es
         * solo para el admin. */
        allow create: if isService() || isDemoRW(cid)
          || (isMember(cid) && subActive(cid)
              && (isClinical(cid)
                  || !request.resource.data.keys().hasAny(patientClinicalFields())));
        allow delete: if isService() || isDemoRW(cid) || (isAdmin(cid) && subActive(cid));
        // Escritura: suscripción vigente + el RBAC de EMR (el asistente no toca
        // los campos clínicos; ver patientClinicalFields()).
        allow update: if isService() || isDemoRW(cid)
          || (isMember(cid) && subActive(cid)
              && (isClinical(cid)
                  || !request.resource.data.diff(resource.data).affectedKeys().hasAny(patientClinicalFields())));
      }
      match /appointments/{docId}{
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // billing: lo escriben admin y caja según la matriz; las reglas lo dejan en
      // isMember (pendiente de la fase 2: enviar a cobro vs. finalizar).
      match /billing/{docId}     {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      match /procedures/{docId}  {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
                /* practice.config = solo admin. El precio del catálogo define lo que se
           le cobra al paciente y lo que entra en cada presupuesto: no puede
           cambiarlo cualquier miembro. */
        allow write: if (isAdmin(cid) && subActive(cid)) || isService() || isDemoRW(cid);
      }
      match /budgets/{docId}     {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Dinero (caja/gastos): el dentista NO maneja dinero. Lectura: cualquier
      // miembro; escritura: solo staff (admin/asistente). Cierra el fraude
      // financiero vía SDK directo saltándose el RBAC de la UI.
      match /payments/{docId}    { allow read: if isMember(cid) || isService() || isDemo(cid);
                                   allow write: if (isCaja(cid) && subActive(cid)) || isService() || isDemoRW(cid); }
      // Gastos = costos del negocio (alquiler, proveedores, sueldos). De fábrica solo el
      // dueño (expenses.manage), y también en LECTURA: el gating de la UI no alcanza porque el
      // cliente lee Firestore directo y podría sacarlos por SDK. La clínica puede dárselo a otro rol.
      match /expenses/{docId}    { allow read: if puedeGastos(cid) || isService() || isDemoRW(cid);
                                   allow write: if (puedeGastos(cid) && subActive(cid)) || isService() || isDemoRW(cid); }
      match /stock/{docId}       {
        allow read:  if isMember(cid) || isService() || isDemoRW(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      match /stockMoves/{docId}  {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      match /waitlist/{docId}    {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      /* Cola de salida hacia Botika. CADA doc que entra acá lo materializa y lo
         ENVÍA el cron de Botika: son mensajes de WhatsApp que paga el dueño del
         SaaS. `integraciones` es feature de Clínica+, la UI lo bloquea, pero la
         regla decía `canWrite` (solo suscripción) — así que un cliente de $45
         disparaba envíos por SDK sin pasar por la UI. */
      match /outbox/{docId}      {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica', 'cadena']);
      }
      // Lock atómico de slots de reserva online (lo crea el service user).
      match /slotLocks/{docId}   {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Monitor de recuperación post-op (lo escriben miembros y el service user)
      match /recoveryMonitors/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Análisis IA de radiografías (lo escriben miembros y el service user)
      match /radiographs/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
                /* + isClinical: una radiografía y sus hallazgos son ficha clínica. Sin
           esto el asistente podía fabricar hallazgos y BORRAR imágenes, que la
           interfaz le prohíbe con emr.write. */
        allow write: if canWritePremium(cid, ['clinica','cadena']) && (isClinical(cid) || isService() || isDemoRW(cid));
      }
      // Firma electrónica de consentimientos. La firma remota (página pública
      // /firmar) la escribe el service user vía /api/firmar → cubierta por isService().
      match /signatures/{sid} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
                /* Consentimientos: los maneja el staff (admin|asistente), no el dentista.
           Y el BORRADO se cierra: una firma electrónica emitida es prueba legal;
           por SDK cualquiera podía eliminarla y en la interfaz eso no existe. */
        allow create, update: if canWritePremium(cid, ['clinica','cadena']) && (isRecepcion(cid) || isService() || isDemoRW(cid));
        allow delete: if isService() || isDemoRW(cid);
      }
      // Documentos clínicos (Historia Clínica y demás documentos del paciente). Los edita quien
      // gestiona formularios (engagement.forms: de fábrica admin, caja, recepción) o escribe la ficha
      // (emr.write: de fábrica el dentista); el asistente de fábrica solo lee. Es el espejo de
      // `puedeEditarDocumentos` (lib/documentosClinicos.ts): si cambia la matriz de roles o lo que
      // reparte la clínica, cambian las dos a la vez. Con la suscripción vencida se lee y no se
      // escribe. No se borran desde la app (se anulan); el borrado es solo para "Reiniciar demo".
      match /clinicalDocs/{docId} {
        allow read: if isMember(cid) || isService() || isDemo(cid);
        allow create, update: if isService() || isDemoRW(cid)
          || (subActive(cid) && (isRecepcion(cid) || isClinical(cid)));
        allow delete: if isService() || isDemoRW(cid);
      }
      // Rutina del administrador (Inicio): un documento por casillero tildado, con id `${paso}__${periodo}`
      // (lib/rutinaAdmin.ts). Lo tilda y lo destilda solo el administrador; los miembros lo leen (no es un dato
      // sensible: qué paso y cuándo). Con la suscripción vencida se lee y no se escribe.
      match /routineChecks/{docId} {
        allow read: if isMember(cid) || isService() || isDemo(cid);
        allow create, update, delete: if isService() || isDemoRW(cid) || (isAdmin(cid) && subActive(cid));
      }
      // Módulos de paridad Dentalink (CRM, Laboratorios, Liquidaciones, Box/Sillones)
      match /crmCards/{docId}    {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['cadena']);
      }
      match /campaigns/{docId}   {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['cadena']);
      }
      match /labOrders/{docId}   {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      // Liquidaciones = cuánto gana cada profesional. Es dato salarial: no lo ve
      // el resto del equipo (ni siquiera el dentista sus propias comisiones por
      // esta vía) ni la recepción. De fábrica solo el dueño (billing.reports); la clínica puede dárselo a otro rol.
      match /settlements/{docId} {
        allow read:  if puedeLiquidaciones(cid) || isService() || isDemo(cid);
        allow write: if (puedeLiquidaciones(cid) && canWritePremium(cid, ['clinica','cadena'])) || isService() || isDemoRW(cid);
      }
      match /boxes/{docId}       {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWritePremium(cid, ['clinica','cadena']);
      }
      // Notas del paciente: comentarios administrativos / tareas de gestión / emails
      match /patientNotes/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Documentos fiscales: boletas emitidas / devoluciones
      match /fiscalDocs/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
                /* Boletas y devoluciones: las emite el staff. El dentista podía emitir
           devoluciones y borrar boletas. Un documento fiscal se anula, no se
           borra: el delete queda para el admin. */
        allow create, update: if (isCaja(cid) && subActive(cid)) || isService() || isDemoRW(cid);
        allow delete: if isAdmin(cid) || isService() || isDemoRW(cid);
      }
      // Sesiones de caja: apertura/cierre con arqueo
      match /cashSessions/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
                /* isCaja, igual que payments: el dentista no maneja dinero. Podía cerrar
           el arqueo de la recepción declarando 0 contado, que es justo el control
           que detecta faltantes. */
        // `caja` es feature de Clínica+ (la UI ya lo bloquea): además de rol, plan.
        allow write: if (isCaja(cid) && subActive(cid) && effectivePlan(cid) in ['clinica', 'cadena'])
                        || isService() || isDemoRW(cid);
      }
      // Ciclos de esterilización de instrumental (cumplimiento)
      match /sterilizationCycles/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Chat interno del equipo (canal «Equipo»: lo lee todo miembro)
      match /teamMessages/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Mensajes directos del chat: 1 a 1, y las copias de una difusión del admin.
      //
      // La ÚNICA colección de la clínica que un miembro no lee entera: un directo
      // es de sus dos participantes y del admin, nadie más (ni el usuario de
      // servicio: ningún proceso del servidor los necesita). Como las reglas NO
      // son filtros, el store de un no-admin la consulta con
      // `participants array-contains <su uid>`; pedirla completa falla entera.
      //
      // La difusión general se guarda como UN documento por destinatario con el
      // mismo `difusionId`: cada uno lee su copia y ninguna otra, así que no hay
      // forma de saber a quién más le llegó. El admin sí, porque lee todo. Los ids
      // de las copias son aleatorios (lib/chat.ts idMensaje): si se derivaran del
      // destinatario, cualquiera adivinaría la ruta de la copia de un compañero y
      // con un alta de prueba (libre → pasa, ocupada → falla) sabría si la recibió.
      match /directMessages/{docId} {
        allow read: if isDemo(cid)
          || (isMember(cid) && (request.auth.uid in resource.data.participants || isAdmin(cid)));
        allow create: if isDemoRW(cid)
          || (isMember(cid) && subActive(cid) && directoValido(cid, docId));
        // Solo el destinatario, y solo para marcarlo leído. Sin subActive a
        // propósito: marcar leído es parte de CONSULTAR (no crea contenido), y con
        // la suscripción vencida la clínica sigue leyendo su chat.
        allow update: if isDemoRW(cid)
          || (isMember(cid)
              && request.auth.uid == resource.data.toId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
              && request.resource.data.readAt is string);
        // Un mensaje no se borra, ni siquiera el admin. La demo sí, para reiniciarla.
        allow delete: if isDemoRW(cid);
      }
      // Encuestas (definición): admin escribe; la respuesta pública entra por route de servicio
      match /surveys/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Respuestas de encuestas: alta pública (sin sesión) vía route de servicio
      match /surveyResponses/{docId} {
        allow read: if isMember(cid) || isService() || isDemo(cid);
        allow write: if isService() || isDemoRW(cid);
      }
      // Tareas de gestión (bandeja captura/control/cobranza/cita)
      match /mgmtTasks/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Registro ambiental de residuos (cumplimiento)
      match /environmentalLogs/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Biblioteca de videos educativos / 3D
      match /eduVideos/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
      // Sucursales / sedes (multi-sede)
      match /branches/{docId} {
        allow read:  if isMember(cid) || isService() || isDemo(cid);
        allow write: if canWrite(cid);
      }
    }

    // Todo lo demás: denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
