{
  "name": "novudent-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"node --test test/firestore-rules.test.mjs\"",
    "test:backend": "firebase emulators:exec --only firestore \"vitest run -c vitest.emulador.config.ts\"",
    "migracion:exportar": "node scripts/migracion/exportar-firestore.mjs",
    "verificar:cobro": "node scripts/verificar-cobro.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "marca": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generar-marca.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "manual:capturas": "playwright test -c docs/manual/playwright.manual.config.ts capturar",
    "manual:pdf": "playwright test -c docs/manual/playwright.manual.config.ts generar"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase": "^12.14.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "0.451.0",
    "next": "^16.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "20.16.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "autoprefixer": "10.4.20",
    "playwright": "^1.60.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vitest": "^4.1.9"
  }
}
